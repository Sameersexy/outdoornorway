{
  "extraKnownMarketplaces": {
    "outdoornorway": {
      "source": {
        "source": "github",
        "repo": "Sameersexy/outdoornorway"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "claude-code-setup@anthropic-plugin-directory": true,
    "ponytail@ponytail": true,
    "repo-band@outdoornorway": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
