{
  "mcpServers": {
    "scrapling": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "command -v scrapling >/dev/null 2>&1 || { echo 'scrapling MCP: Scrapling is not installed. The SessionStart hook installs it in cloud sessions only. In a clone, run: pip install \"scrapling[ai]\"' >&2; exit 1; }; exec scrapling mcp"
      ]
    },
    "TalkToFigma": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "cursor-talk-to-figma-mcp@0.3.5"
      ]
    },
    "figma-console": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "figma-console-mcp@1.41.5"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN:-}",
        "ENABLE_MCP_APPS": "true"
      }
    },
    "framelink-figma": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp@0.13.2",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY:-}",
        "FRAMELINK_TELEMETRY": "off"
      }
    }
  }
}
